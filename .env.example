# Private server-side connection. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=
# Isolate Equipment Tracker from other apps in a shared PostgreSQL project.
# Omit DATABASE_SCHEMA when using local SQLite.
DATABASE_SCHEMA=equipment_tracker
# Signs the login cookie. Use one long random value and keep it stable.
SECRET_KEY=
# Shared website sign-in. Set both in Vercel. Leave them empty in this file.
APP_LOGIN_USER=
APP_LOGIN_PASSWORD=
# Long random value sent as: Authorization: Bearer <token>
TRACKER_API_TOKEN=
